# Build output
/build/
/dist/
*.o
*.obj
*.exe
chessai
/chessai-tests
/chessai-gate
/tuner
/extract

# Profiling / PGO
*.gcda
*.gcno
*.profraw
*.profdata

# Engine data (kept out of the repo)...
/nets/*
*.nnue
/syzygy/
*.bin
# ...except the NNUE network the build embeds as the default eval
!/nets/net1.bin

# Match testing (scripts/match.py): built version binaries, opening suites, PGNs
/bin/
/books/
/games/
*.pgn

# fastchess persistent config, written into the CWD when a match runs
/config.json

# Texel tuning data (tools/extract + tools/tune): datasets and emitted tables
/dataset.txt
/tuned.txt

# Self-play board viewers generated by scripts/watch_selfplay.py
*.html
# ...but the opening-book dashboard page is source
!/book/static/*.html

# Opening book (book/): runtime database and virtualenv
/book/data/
/book/.venv/

# Python tooling caches
__pycache__/
*.pyc

# Editor / IDE
.vscode/
.idea/
*.user

# Claude Code (local, machine-specific settings)
.claude/settings.local.json
